      "parameters": {
        "jsCode": "// Suponiendo que del formulario recibes una fecha\nconst fechaInput = new Date($input.first().json.fecha_consulta || Date.now());\n\n// Formato requerido por Gmail: YYYY/MM/DD\nconst year = fechaInput.getFullYear();\nconst month = String(fechaInput.getMonth() + 1).padStart(2, '0');\nconst day = String(fechaInput.getDate()).padStart(2, '0');\nconst diaFormateado = `${year}/${month}/${day}`;\n\n// Calcular el día siguiente para el límite superior \"before:\"\nconst mañana = new Date(fechaInput);\nmañana.setDate(mañana.getDate() + 1);\nconst mañanaYear = mañana.getFullYear();\nconst mañanaMonth = String(mañana.getMonth() + 1).padStart(2, '0');\nconst mañanaDay = String(mañana.getDate()).padStart(2, '0');\nconst mañanaFormateado = `${mañanaYear}/${mañanaMonth}/${mañanaDay}`;\n\nreturn {\n  json: {\n    fechaInicio: diaFormateado,\n    fechaFin: mañanaFormateado\n  }\n};"
